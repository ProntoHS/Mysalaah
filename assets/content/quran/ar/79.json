[{"n":1,"text":"وَٱلنَّـٰزِعَٰتِ غَرۡقٗا","said":"WaalnnaziAAati gharqan"},{"n":2,"text":"وَٱلنَّـٰشِطَٰتِ نَشۡطٗا","said":"Waalnnashitati nashtan"},{"n":3,"text":"وَٱلسَّـٰبِحَٰتِ سَبۡحٗا","said":"Waalssabihati sabhan"},{"n":4,"text":"فَٱلسَّـٰبِقَٰتِ سَبۡقٗا","said":"Faalssabiqati sabqan"},{"n":5,"text":"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا","said":"Faalmudabbirati amran"},{"n":6,"text":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","said":"Yawma tarjufu alrrajifatu"},{"n":7,"text":"تَتۡبَعُهَا ٱلرَّادِفَةُ","said":"TatbaAAuha alrradifatu"},{"n":8,"text":"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ","said":"Quloobun yawmaithin wajifatun"},{"n":9,"text":"أَبۡصَٰرُهَا خَٰشِعَةٞ","said":"Absaruha khashiAAatun"},{"n":10,"text":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ","said":"Yaqooloona ainna lamardoodoona fee alhafirati"},{"n":11,"text":"أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ","said":"Aitha kunna AAithaman nakhiratan"},{"n":12,"text":"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ","said":"Qaloo tilka ithan karratun khasiratun"},{"n":13,"text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ","said":"Fainnama hiya zajratun wahidatun"},{"n":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","said":"Faitha hum bialssahirati"},{"n":15,"text":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","said":"Hal ataka hadeethu moosa"},{"n":16,"text":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى","said":"Ith nadahu rabbuhu bialwadi almuqaddasi tuwan"},{"n":17,"text":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ","said":"Ithhab ila firAAawna innahu tagha"},{"n":18,"text":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","said":"Faqul hal laka ila an tazakka"},{"n":19,"text":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ","said":"Waahdiyaka ila rabbika fatakhsha"},{"n":20,"text":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ","said":"Faarahu alayata alkubra"},{"n":21,"text":"فَكَذَّبَ وَعَصَىٰ","said":"Fakaththaba waAAasa"},{"n":22,"text":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ","said":"Thumma adbara yasAAa"},{"n":23,"text":"فَحَشَرَ فَنَادَىٰ","said":"Fahashara fanada"},{"n":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ","said":"Faqala ana rabbukumu alaAAla"},{"n":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ","said":"Faakhathahu Allahu nakala alakhirati waaloola"},{"n":26,"text":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ","said":"Inna fee thalika laAAibratan liman yakhsha"},{"n":27,"text":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا","said":"Aantum ashaddu khalqan ami alssamao banaha"},{"n":28,"text":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا","said":"RafaAAa samkaha fasawwaha"},{"n":29,"text":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا","said":"Waaghtasha laylaha waakhraja duhaha"},{"n":30,"text":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ","said":"Waalarda baAAda thalika dahaha"},{"n":31,"text":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا","said":"Akhraja minha maaha wamarAAaha"},{"n":32,"text":"وَٱلۡجِبَالَ أَرۡسَىٰهَا","said":"Waaljibala arsaha"},{"n":33,"text":"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","said":"MataAAan lakum walianAAamikum"},{"n":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","said":"Faitha jaati alttammatu alkubra"},{"n":35,"text":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ","said":"Yawma yatathakkaru alinsanu ma saAAa"},{"n":36,"text":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ","said":"Waburrizati aljaheemu liman yara"},{"n":37,"text":"فَأَمَّا مَن طَغَىٰ","said":"Faamma man tagha"},{"n":38,"text":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","said":"Waathara alhayata alddunya"},{"n":39,"text":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ","said":"Fainna aljaheema hiya almawa"},{"n":40,"text":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ","said":"Waama man khafa maqama rabbihi wanaha alnnafsa AAani alhawa"},{"n":41,"text":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ","said":"Fainna aljannata hiya almawa"},{"n":42,"text":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا","said":"Yasaloonaka AAani alssaAAati ayyana mursaha"},{"n":43,"text":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ","said":"Feema anta min thikraha"},{"n":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","said":"Ila rabbika muntahaha"},{"n":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا","said":"Innama anta munthiru man yakhshaha"},{"n":46,"text":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا","said":"Kaannahum yawma yarawnaha lam yalbathoo illa AAashiyyatan aw duhaha"}]
