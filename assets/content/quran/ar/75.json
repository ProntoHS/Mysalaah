[{"n":1,"text":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ","said":"La oqsimu biyawmi alqiyamati"},{"n":2,"text":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ","said":"Wala oqsimu bialnnafsi allawwamati"},{"n":3,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ","said":"Ayahsabu alinsanu allan najmaAAa AAithamahu"},{"n":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ","said":"Bala qadireena AAala an nusawwiya bananahu"},{"n":5,"text":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ","said":"Bal yureedu alinsanu liyafjura amamahu"},{"n":6,"text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ","said":"Yasalu ayyana yawmu alqiyamati"},{"n":7,"text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ","said":"Faitha bariqa albasaru"},{"n":8,"text":"وَخَسَفَ ٱلۡقَمَرُ","said":"Wakhasafa alqamaru"},{"n":9,"text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","said":"WajumiAAa alshshamsu waalqamaru"},{"n":10,"text":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ","said":"Yaqoolu alinsanu yawmaithin ayna almafarru"},{"n":11,"text":"كَلَّا لَا وَزَرَ","said":"Kalla la wazara"},{"n":12,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ","said":"Ila rabbika yawmaithin almustaqarru"},{"n":13,"text":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ","said":"Yunabbao alinsanu yawmaithin bima qaddama waakhkhara"},{"n":14,"text":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ","said":"Bali alinsanu AAala nafsihi baseeratun"},{"n":15,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","said":"Walaw alqa maAAatheerahu"},{"n":16,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ","said":"La tuharrik bihi lisanaka litaAAjala bihi"},{"n":17,"text":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ","said":"Inna AAalayna jamAAahu waquranahu"},{"n":18,"text":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ","said":"Faitha qaranahu faittabiAA quranahu"},{"n":19,"text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ","said":"Thumma inna AAalayna bayanahu"},{"n":20,"text":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ","said":"Kalla bal tuhibboona alAAajilata"},{"n":21,"text":"وَتَذَرُونَ ٱلۡأٓخِرَةَ","said":"Watatharoona alakhirata"},{"n":22,"text":"وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ","said":"Wujoohun yawmaithin nadiratun"},{"n":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٞ","said":"Ila rabbiha nathiratun"},{"n":24,"text":"وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ","said":"Wawujoohun yawmaithin basiratun"},{"n":25,"text":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ","said":"Tathunnu an yufAAala biha faqiratun"},{"n":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ","said":"Kalla itha balaghati alttaraqiya"},{"n":27,"text":"وَقِيلَ مَنۡۜ رَاقٖ","said":"Waqeela man raqin"},{"n":28,"text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ","said":"Wathanna annahu alfiraqu"},{"n":29,"text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","said":"Wailtaffati alssaqu bialssaqi"},{"n":30,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ","said":"Ila rabbika yawmaithin almasaqu"},{"n":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","said":"Fala saddaqa wala salla"},{"n":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","said":"Walakin kaththaba watawalla"},{"n":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ","said":"Thumma thahaba ila ahlihi yatamatta"},{"n":34,"text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ","said":"Awla laka faawla"},{"n":35,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ","said":"Thumma awla laka faawla"},{"n":36,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى","said":"Ayahsabu alinsanu an yutraka sudan"},{"n":37,"text":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ","said":"Alam yaku nutfatan min manayyin yumna"},{"n":38,"text":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ","said":"Thumma kana AAalaqatan fakhalaqa fasawwa"},{"n":39,"text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","said":"FajaAAala minhu alzzawjayni alththakara waalontha"},{"n":40,"text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ","said":"Alaysa thalika biqadirin AAala an yuhyiya almawta"}]
