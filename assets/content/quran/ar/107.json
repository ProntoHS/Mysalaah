[{"n":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","said":"Araayta allathee yukaththibu bialddeeni"},{"n":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","said":"Fathalika allathee yaduAAAAu alyateema"},{"n":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","said":"Wala yahuddu AAala taAAami almiskeeni"},{"n":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","said":"Fawaylun lilmusalleena"},{"n":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","said":"Allatheena hum AAan salatihim sahoona"},{"n":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","said":"Allatheena hum yuraoona"},{"n":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","said":"WayamnaAAoona almaAAoona"}]
