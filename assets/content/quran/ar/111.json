[{"n":1,"text":"تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ","said":"Tabbat yada abee lahabin watabba"},{"n":2,"text":"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ","said":"Ma aghna AAanhu maluhu wama kasaba"},{"n":3,"text":"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ","said":"Sayasla naran thata lahabin"},{"n":4,"text":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ","said":"Waimraatuhu hammalata alhatabi"},{"n":5,"text":"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ","said":"Fee jeediha hablun min masadin"}]
