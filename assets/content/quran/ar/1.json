[{"n":1,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","said":"Bismi Allahi alrrahmani alrraheemi"},{"n":2,"text":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","said":"Alhamdu lillahi rabbi alAAalameena"},{"n":3,"text":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","said":"Alrrahmani alrraheemi"},{"n":4,"text":"مَٰلِكِ يَوۡمِ ٱلدِّينِ","said":"Maliki yawmi alddeeni"},{"n":5,"text":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ","said":"Iyyaka naAAbudu waiyyaka nastaAAeenu"},{"n":6,"text":"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","said":"Ihdina alssirata almustaqeema"},{"n":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ","said":"Sirata allatheena anAAamta AAalayhim ghayri almaghdoobi AAalayhim wala alddalleena"}]
