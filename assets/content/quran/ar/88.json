[{"n":1,"text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","said":"Hal ataka hadeethu alghashiyati"},{"n":2,"text":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","said":"Wujoohun yawmaithin khashiAAatun"},{"n":3,"text":"عَامِلَةٞ نَّاصِبَةٞ","said":"AAamilatun nasibatun"},{"n":4,"text":"تَصۡلَىٰ نَارًا حَامِيَةٗ","said":"Tasla naran hamiyatan"},{"n":5,"text":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","said":"Tusqa min AAaynin aniyatin"},{"n":6,"text":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","said":"Laysa lahum taAAamun illa min dareeAAin"},{"n":7,"text":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","said":"La yusminu wala yughnee min jooAAin"},{"n":8,"text":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","said":"Wujoohun yawmaithin naAAimatun"},{"n":9,"text":"لِّسَعۡيِهَا رَاضِيَةٞ","said":"LisaAAyiha radiyatun"},{"n":10,"text":"فِي جَنَّةٍ عَالِيَةٖ","said":"Fee jannatin AAaliyatin"},{"n":11,"text":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","said":"La tasmaAAu feeha laghiyatan"},{"n":12,"text":"فِيهَا عَيۡنٞ جَارِيَةٞ","said":"Feeha AAaynun jariyatun"},{"n":13,"text":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","said":"Feeha sururun marfooAAatun"},{"n":14,"text":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","said":"Waakwabun mawdooAAatun"},{"n":15,"text":"وَنَمَارِقُ مَصۡفُوفَةٞ","said":"Wanamariqu masfoofatun"},{"n":16,"text":"وَزَرَابِيُّ مَبۡثُوثَةٌ","said":"Wazarabiyyu mabthoothatun"},{"n":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","said":"Afala yanthuroona ila alibili kayfa khuliqat"},{"n":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","said":"Waila alssamai kayfa rufiAAat"},{"n":19,"text":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","said":"Waila aljibali kayfa nusibat"},{"n":20,"text":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","said":"Waila alardi kayfa sutihat"},{"n":21,"text":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","said":"Fathakkir innama anta muthakkirun"},{"n":22,"text":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","said":"Lasta AAalayhim bimusaytirin"},{"n":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","said":"Illa man tawalla wakafara"},{"n":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","said":"FayuAAaththibuhu Allahu alAAathaba alakbara"},{"n":25,"text":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","said":"Inna ilayna iyabahum"},{"n":26,"text":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","said":"Thumma inna AAalayna hisabahum"}]
