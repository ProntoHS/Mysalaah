[{"n":1,"text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","said":"Itha alssamao inshaqqat"},{"n":2,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","said":"Waathinat lirabbiha wahuqqat"},{"n":3,"text":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","said":"Waitha alardu muddat"},{"n":4,"text":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","said":"Waalqat ma feeha watakhallat"},{"n":5,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","said":"Waathinat lirabbiha wahuqqat"},{"n":6,"text":"يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ","said":"Ya ayyuha alinsanu innaka kadihun ila rabbika kadhan famulaqeehi"},{"n":7,"text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","said":"Faama man ootiya kitabahu biyameenihi"},{"n":8,"text":"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا","said":"Fasawfa yuhasabu hisaban yaseeran"},{"n":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا","said":"Wayanqalibu ila ahlihi masrooran"},{"n":10,"text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","said":"Waamma man ootiya kitabahu waraa thahrihi"},{"n":11,"text":"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا","said":"Fasawfa yadAAoo thubooran"},{"n":12,"text":"وَيَصۡلَىٰ سَعِيرًا","said":"Wayasla saAAeeran"},{"n":13,"text":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا","said":"Innahu kana fee ahlihi masrooran"},{"n":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","said":"Innahu thanna an lan yahoora"},{"n":15,"text":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا","said":"Bala inna rabbahu kana bihi baseeran"},{"n":16,"text":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ","said":"Fala oqsimu bialshshafaqi"},{"n":17,"text":"وَٱلَّيۡلِ وَمَا وَسَقَ","said":"Waallayli wama wasaqa"},{"n":18,"text":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ","said":"Waalqamari itha ittasaqa"},{"n":19,"text":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ","said":"Latarkabunna tabaqan AAan tabaqin"},{"n":20,"text":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","said":"Fama lahum la yuminoona"},{"n":21,"text":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","said":"Waitha quria AAalayhimu alquranu la yasjudoona"},{"n":22,"text":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ","said":"Bali allatheena kafaroo yukaththiboona"},{"n":23,"text":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","said":"WaAllahu aAAlamu bima yooAAoona"},{"n":24,"text":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ","said":"Fabashshirhum biAAathabin aleemin"},{"n":25,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ","said":"Illa allatheena amanoo waAAamiloo alssalihati lahum ajrun ghayru mamnoonin"}]
