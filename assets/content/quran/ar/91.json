[{"n":1,"text":"وَٱلشَّمۡسِ وَضُحَىٰهَا","said":"Waalshshamsi waduhaha"},{"n":2,"text":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا","said":"Waalqamari itha talaha"},{"n":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","said":"Waalnnahari itha jallaha"},{"n":4,"text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا","said":"Waallayli itha yaghshaha"},{"n":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","said":"Waalssamai wama banaha"},{"n":6,"text":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا","said":"Waalardi wama tahaha"},{"n":7,"text":"وَنَفۡسٖ وَمَا سَوَّىٰهَا","said":"Wanafsin wama sawwaha"},{"n":8,"text":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا","said":"Faalhamaha fujooraha wataqwaha"},{"n":9,"text":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا","said":"Qad aflaha man zakkaha"},{"n":10,"text":"وَقَدۡ خَابَ مَن دَسَّىٰهَا","said":"Waqad khaba man dassaha"},{"n":11,"text":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ","said":"Kaththabat thamoodu bitaghwaha"},{"n":12,"text":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا","said":"Ithi inbaAAatha ashqaha"},{"n":13,"text":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا","said":"Faqala lahum rasoolu Allahi naqata Allahi wasuqyaha"},{"n":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا","said":"Fakaththaboohu faAAaqarooha fadamdama AAalayhim rabbuhum bithanbihim fasawwaha"},{"n":15,"text":"وَلَا يَخَافُ عُقۡبَٰهَا","said":"Wala yakhafu AAuqbaha"}]
