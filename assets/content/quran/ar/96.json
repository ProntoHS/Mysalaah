[{"n":1,"text":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","said":"Iqra biismi rabbika allathee khalaqa"},{"n":2,"text":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","said":"Khalaqa alinsana min AAalaqin"},{"n":3,"text":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","said":"Iqra warabbuka alakramu"},{"n":4,"text":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","said":"Allathee AAallama bialqalami"},{"n":5,"text":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","said":"AAallama alinsana ma lam yaAAlam"},{"n":6,"text":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","said":"Kalla inna alinsana layatgha"},{"n":7,"text":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","said":"An raahu istaghna"},{"n":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","said":"Inna ila rabbika alrrujAAa"},{"n":9,"text":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","said":"Araayta allathee yanha"},{"n":10,"text":"عَبۡدًا إِذَا صَلَّىٰٓ","said":"AAabdan itha salla"},{"n":11,"text":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","said":"Araayta in kana AAala alhuda"},{"n":12,"text":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","said":"Aw amara bialttaqwa"},{"n":13,"text":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","said":"Araayta in kaththaba watawalla"},{"n":14,"text":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","said":"Alam yaAAlam bianna Allaha yara"},{"n":15,"text":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","said":"Kalla lain lam yantahi lanasfaAAan bialnnasiyati"},{"n":16,"text":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","said":"Nasiyatin kathibatin khatiatin"},{"n":17,"text":"فَلۡيَدۡعُ نَادِيَهُۥ","said":"FalyadAAu nadiyahu"},{"n":18,"text":"سَنَدۡعُ ٱلزَّبَانِيَةَ","said":"SanadAAu alzzabaniyata"},{"n":19,"text":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","said":"Kalla la tutiAAhu waosjud waiqtarib"}]
