[{"n":1,"text":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ","said":"Itha alshshamsu kuwwirat"},{"n":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ","said":"Waitha alnnujoomu inkadarat"},{"n":3,"text":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ","said":"Waitha aljibalu suyyirat"},{"n":4,"text":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ","said":"Waitha alAAisharu AAuttilat"},{"n":5,"text":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ","said":"Waitha alwuhooshu hushirat"},{"n":6,"text":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ","said":"Waitha albiharu sujjirat"},{"n":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ","said":"Waitha alnnufoosu zuwwijat"},{"n":8,"text":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ","said":"Waitha almawoodatu suilat"},{"n":9,"text":"بِأَيِّ ذَنۢبٖ قُتِلَتۡ","said":"Biayyi thanbin qutilat"},{"n":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ","said":"Waitha alssuhufu nushirat"},{"n":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ","said":"Waitha alssamao kushitat"},{"n":12,"text":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ","said":"Waitha aljaheemu suAAAAirat"},{"n":13,"text":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ","said":"Waitha aljannatu ozlifat"},{"n":14,"text":"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ","said":"AAalimat nafsun ma ahdarat"},{"n":15,"text":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ","said":"Fala oqsimu bialkhunnasi"},{"n":16,"text":"ٱلۡجَوَارِ ٱلۡكُنَّسِ","said":"Aljawari alkunnasi"},{"n":17,"text":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ","said":"Waallayli itha AAasAAasa"},{"n":18,"text":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ","said":"Waalssubhi itha tanaffasa"},{"n":19,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","said":"Innahu laqawlu rasoolin kareemin"},{"n":20,"text":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ","said":"Thee quwwatin AAinda thee alAAarshi makeenin"},{"n":21,"text":"مُّطَاعٖ ثَمَّ أَمِينٖ","said":"MutaAAin thamma ameenin"},{"n":22,"text":"وَمَا صَاحِبُكُم بِمَجۡنُونٖ","said":"Wama sahibukum bimajnoonin"},{"n":23,"text":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ","said":"Walaqad raahu bialofuqi almubeeni"},{"n":24,"text":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ","said":"Wama huwa AAala alghaybi bidaneenin"},{"n":25,"text":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ","said":"Wama huwa biqawli shaytanin rajeemin"},{"n":26,"text":"فَأَيۡنَ تَذۡهَبُونَ","said":"Faayna tathhaboona"},{"n":27,"text":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ","said":"In huwa illa thikrun lilAAalameena"},{"n":28,"text":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ","said":"Liman shaa minkum an yastaqeema"},{"n":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ","said":"Wama tashaoona illa an yashaa Allahu rabbu alAAalameena"}]
