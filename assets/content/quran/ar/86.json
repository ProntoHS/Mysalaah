[{"n":1,"text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","said":"Waalssamai waalttariqi"},{"n":2,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","said":"Wama adraka ma alttariqu"},{"n":3,"text":"ٱلنَّجۡمُ ٱلثَّاقِبُ","said":"Alnnajmu alththaqibu"},{"n":4,"text":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","said":"In kullu nafsin lamma AAalayha hafithun"},{"n":5,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","said":"Falyanthuri alinsanu mimma khuliqa"},{"n":6,"text":"خُلِقَ مِن مَّآءٖ دَافِقٖ","said":"Khuliqa min main dafiqin"},{"n":7,"text":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","said":"Yakhruju min bayni alssulbi waalttaraibi"},{"n":8,"text":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","said":"Innahu AAala rajAAihi laqadirun"},{"n":9,"text":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","said":"Yawma tubla alssarairu"},{"n":10,"text":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","said":"Fama lahu min quwwatin wala nasirin"},{"n":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","said":"Waalssamai thati alrrajAAi"},{"n":12,"text":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","said":"Waalardi thati alssadAAi"},{"n":13,"text":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","said":"Innahu laqawlun faslun"},{"n":14,"text":"وَمَا هُوَ بِٱلۡهَزۡلِ","said":"Wama huwa bialhazli"},{"n":15,"text":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","said":"Innahum yakeedoona kaydan"},{"n":16,"text":"وَأَكِيدُ كَيۡدٗا","said":"Waakeedu kaydan"},{"n":17,"text":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","said":"Famahhili alkafireena amhilhum ruwaydan"}]
