[{"n":1,"text":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","said":"Alhakumu alttakathuru"},{"n":2,"text":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","said":"Hatta zurtumu almaqabira"},{"n":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُونَ","said":"Kalla sawfa taAAlamoona"},{"n":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","said":"Thumma kalla sawfa taAAlamoona"},{"n":5,"text":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","said":"Kalla law taAAlamoona AAilma alyaqeeni"},{"n":6,"text":"لَتَرَوُنَّ ٱلۡجَحِيمَ","said":"Latarawunna aljaheema"},{"n":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","said":"Thumma latarawunnaha AAayna alyaqeeni"},{"n":8,"text":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","said":"Thumma latusalunna yawmaithin AAani alnnaAAeemi"}]
