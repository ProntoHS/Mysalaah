[{"n":1,"text":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ","said":"La oqsimu bihatha albaladi"},{"n":2,"text":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ","said":"Waanta hillun bihatha albaladi"},{"n":3,"text":"وَوَالِدٖ وَمَا وَلَدَ","said":"Wawalidin wama walada"},{"n":4,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ","said":"Laqad khalaqna alinsana fee kabadin"},{"n":5,"text":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ","said":"Ayahsabu an lan yaqdira AAalayhi ahadun"},{"n":6,"text":"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا","said":"Yaqoolu ahlaktu malan lubadan"},{"n":7,"text":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ","said":"Ayahsabu an lam yarahu ahadun"},{"n":8,"text":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","said":"Alam najAAal lahu AAaynayni"},{"n":9,"text":"وَلِسَانٗا وَشَفَتَيۡنِ","said":"Walisanan washafatayni"},{"n":10,"text":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ","said":"Wahadaynahu alnnajdayni"},{"n":11,"text":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ","said":"Fala iqtahama alAAaqabata"},{"n":12,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ","said":"Wama adraka ma alAAaqabatu"},{"n":13,"text":"فَكُّ رَقَبَةٍ","said":"Fakku raqabatin"},{"n":14,"text":"أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ","said":"Aw itAAamun fee yawmin thee masghabatin"},{"n":15,"text":"يَتِيمٗا ذَا مَقۡرَبَةٍ","said":"Yateeman tha maqrabatin"},{"n":16,"text":"أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ","said":"Aw miskeenan tha matrabatin"},{"n":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ","said":"Thumma kana mina allatheena amanoo watawasaw bialssabri watawasaw bialmarhamati"},{"n":18,"text":"أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","said":"Olaika ashabu almaymanati"},{"n":19,"text":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","said":"Waallatheena kafaroo biayatina hum ashabu almashamati"},{"n":20,"text":"عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ","said":"AAalayhim narun musadatun"}]
