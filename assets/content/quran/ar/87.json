[{"n":1,"text":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","said":"Sabbihi isma rabbika alaAAla"},{"n":2,"text":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","said":"Allathee khalaqa fasawwa"},{"n":3,"text":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","said":"Waallathee qaddara fahada"},{"n":4,"text":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","said":"Waallathee akhraja almarAAa"},{"n":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","said":"FajaAAalahu ghuthaan ahwa"},{"n":6,"text":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","said":"Sanuqrioka fala tansa"},{"n":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","said":"Illa ma shaa Allahu innahu yaAAlamu aljahra wama yakhfa"},{"n":8,"text":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","said":"Wanuyassiruka lilyusra"},{"n":9,"text":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","said":"Fathakkir in nafaAAati alththikra"},{"n":10,"text":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","said":"Sayaththakkaru man yakhsha"},{"n":11,"text":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","said":"Wayatajannabuha alashqa"},{"n":12,"text":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","said":"Allathee yasla alnnara alkubra"},{"n":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","said":"Thumma la yamootu feeha wala yahya"},{"n":14,"text":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","said":"Qad aflaha man tazakka"},{"n":15,"text":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","said":"Wathakara isma rabbihi fasalla"},{"n":16,"text":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","said":"Bal tuthiroona alhayata alddunya"},{"n":17,"text":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","said":"Waalakhiratu khayrun waabqa"},{"n":18,"text":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","said":"Inna hatha lafee alssuhufi aloola"},{"n":19,"text":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","said":"Suhufi ibraheema wamoosa"}]
