[{"n":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","said":"Qul aAAoothu birabbi alfalaqi"},{"n":2,"text":"مِن شَرِّ مَا خَلَقَ","said":"Min sharri ma khalaqa"},{"n":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","said":"Wamin sharri ghasiqin itha waqaba"},{"n":4,"text":"وَمِن شَرِّ ٱلنَّفَّـٰثَٰتِ فِي ٱلۡعُقَدِ","said":"Wamin sharri alnnaffathati fee alAAuqadi"},{"n":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","said":"Wamin sharri hasidin itha hasada"}]
