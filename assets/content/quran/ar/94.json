[{"n":1,"text":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","said":"Alam nashrah laka sadraka"},{"n":2,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","said":"WawadaAAna AAanka wizraka"},{"n":3,"text":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","said":"Allathee anqada thahraka"},{"n":4,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","said":"WarafaAAna laka thikraka"},{"n":5,"text":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","said":"Fainna maAAa alAAusri yusran"},{"n":6,"text":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","said":"Inna maAAa alAAusri yusran"},{"n":7,"text":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","said":"Faitha faraghta fainsab"},{"n":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","said":"Waila rabbika fairghab"}]
