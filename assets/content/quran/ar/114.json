[{"n":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","said":"Qul aAAoothu birabbi alnnasi"},{"n":2,"text":"مَلِكِ ٱلنَّاسِ","said":"Maliki alnnasi"},{"n":3,"text":"إِلَٰهِ ٱلنَّاسِ","said":"Ilahi alnnasi"},{"n":4,"text":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","said":"Min sharri alwaswasi alkhannasi"},{"n":5,"text":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","said":"Allathee yuwaswisu fee sudoori alnnasi"},{"n":6,"text":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","said":"Mina aljinnati wa alnnasm"}]
