[{"n":1,"text":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","said":"Qul huwa Allahu ahadun"},{"n":2,"text":"ٱللَّهُ ٱلصَّمَدُ","said":"Allahu alssamadu"},{"n":3,"text":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","said":"Lam yalid walam yooladu"},{"n":4,"text":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","said":"Walam yakun lahu kufuwan ahadun"}]
