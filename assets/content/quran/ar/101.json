[{"n":1,"text":"ٱلۡقَارِعَةُ","said":"AlqariAAatu"},{"n":2,"text":"مَا ٱلۡقَارِعَةُ","said":"Ma alqariAAatu"},{"n":3,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","said":"Wama adraka ma alqariAAatu"},{"n":4,"text":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","said":"Yawma yakoonu alnnasu kaalfarashi almabthoothi"},{"n":5,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","said":"Watakoonu aljibalu kaalAAihni almanfooshi"},{"n":6,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","said":"Faamma man thaqulat mawazeenuhu"},{"n":7,"text":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","said":"Fahuwa fee AAeeshatin radiyatin"},{"n":8,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","said":"Waamma man khaffat mawazeenuhu"},{"n":9,"text":"فَأُمُّهُۥ هَاوِيَةٞ","said":"Faommuhu hawiyatun"},{"n":10,"text":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","said":"Wama adraka ma hiyah"},{"n":11,"text":"نَارٌ حَامِيَةُۢ","said":"Narun hamiyatun"}]
