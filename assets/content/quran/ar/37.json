[{"n":1,"text":"وَٱلصَّـٰٓفَّـٰتِ صَفّٗا","said":"Waalssaffati saffan"},{"n":2,"text":"فَٱلزَّـٰجِرَٰتِ زَجۡرٗا","said":"Faalzzajirati zajran"},{"n":3,"text":"فَٱلتَّـٰلِيَٰتِ ذِكۡرًا","said":"Faalttaliyati thikran"},{"n":4,"text":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ","said":"Inna ilahakum lawahidun"},{"n":5,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ","said":"Rabbu alssamawati waalardi wama baynahuma warabbu almashariqi"},{"n":6,"text":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ","said":"Inna zayyanna alssamaa alddunya bizeenatin alkawakibi"},{"n":7,"text":"وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ","said":"Wahifthan min kulli shaytanin maridin"},{"n":8,"text":"لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ","said":"La yassammaAAoona ila almalai alaAAla wayuqthafoona min kulli janibin"},{"n":9,"text":"دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ","said":"Duhooran walahum AAathabun wasibun"},{"n":10,"text":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ","said":"Illa man khatifa alkhatfata faatbaAAahu shihabun thaqibun"},{"n":11,"text":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ","said":"Faistaftihim ahum ashaddu khalqan am man khalaqna inna khalaqnahum min teenin lazibin"},{"n":12,"text":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ","said":"Bal AAajibta wayaskharoona"},{"n":13,"text":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ","said":"Waitha thukkiroo la yathkuroona"},{"n":14,"text":"وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ","said":"Waitha raaw ayatan yastaskhiroona"},{"n":15,"text":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ","said":"Waqaloo in hatha illa sihrun mubeenun"},{"n":16,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ","said":"Aitha mitna wakunna turaban waAAithaman ainna lamabAAoothoona"},{"n":17,"text":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ","said":"Awaabaona alawwaloona"},{"n":18,"text":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ","said":"Qul naAAam waantum dakhiroona"},{"n":19,"text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ","said":"Fainnama hiya zajratun wahidatun faitha hum yanthuroona"},{"n":20,"text":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ","said":"Waqaloo ya waylana hatha yawmu alddeeni"},{"n":21,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ","said":"Hatha yawmu alfasli allathee kuntum bihi tukaththiboona"},{"n":22,"text":"۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ","said":"Ohshuroo allatheena thalamoo waazwajahum wama kanoo yaAAbudoona"},{"n":23,"text":"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ","said":"Min dooni Allahi faihdoohum ila sirati aljaheemi"},{"n":24,"text":"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ","said":"Waqifoohum innahum masooloona"},{"n":25,"text":"مَا لَكُمۡ لَا تَنَاصَرُونَ","said":"Ma lakum la tanasaroona"},{"n":26,"text":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ","said":"Bal humu alyawma mustaslimoona"},{"n":27,"text":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ","said":"Waaqbala baAAduhum AAala baAAdin yatasaaloona"},{"n":28,"text":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ","said":"Qaloo innakum kuntum tatoonana AAani alyameeni"},{"n":29,"text":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ","said":"Qaloo bal lam takoonoo mumineena"},{"n":30,"text":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ","said":"Wama kana lana AAalaykum min sultanin bal kuntum qawman tagheena"},{"n":31,"text":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ","said":"Fahaqqa AAalayna qawlu rabbina inna lathaiqoona"},{"n":32,"text":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ","said":"Faaghwaynakum inna kunna ghaweena"},{"n":33,"text":"فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ","said":"Fainnahum yawmaithin fee alAAathabi mushtarikoona"},{"n":34,"text":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ","said":"Inna kathalika nafAAalu bialmujrimeena"},{"n":35,"text":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ","said":"Innahum kanoo itha qeela lahum la ilaha illa Allahu yastakbiroona"},{"n":36,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ","said":"Wayaqooloona ainna latarikoo alihatina lishaAAirin majnoonin"},{"n":37,"text":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ","said":"Bal jaa bialhaqqi wasaddaqa almursaleena"},{"n":38,"text":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ","said":"Innakum lathaiqoo alAAathabi alaleemi"},{"n":39,"text":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ","said":"Wama tujzawna illa ma kuntum taAAmaloona"},{"n":40,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","said":"Illa AAibada Allahi almukhlaseena"},{"n":41,"text":"أُوْلَـٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ","said":"Olaika lahum rizqun maAAloomun"},{"n":42,"text":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ","said":"Fawakihu wahum mukramoona"},{"n":43,"text":"فِي جَنَّـٰتِ ٱلنَّعِيمِ","said":"Fee jannati alnnaAAeemi"},{"n":44,"text":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ","said":"AAala sururin mutaqabileena"},{"n":45,"text":"يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ","said":"Yutafu AAalayhim bikasin min maAAeenin"},{"n":46,"text":"بَيۡضَآءَ لَذَّةٖ لِّلشَّـٰرِبِينَ","said":"Baydaa laththatin lilshsharibeena"},{"n":47,"text":"لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ","said":"La feeha ghawlun wala hum AAanha yunzafoona"},{"n":48,"text":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ","said":"WaAAindahum qasiratu alttarfi AAeenun"},{"n":49,"text":"كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ","said":"Kaannahunna baydun maknoonun"},{"n":50,"text":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ","said":"Faaqbala baAAduhum AAala baAAdin yatasaaloona"},{"n":51,"text":"قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ","said":"Qala qailun minhum innee kana lee qareenun"},{"n":52,"text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ","said":"Yaqoolu ainnaka lamina almusaddiqeena"},{"n":53,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ","said":"Aitha mitna wakunna turaban waAAithaman ainna lamadeenoona"},{"n":54,"text":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ","said":"Qala hal antum muttaliAAoona"},{"n":55,"text":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ","said":"FaittalaAAa faraahu fee sawai aljaheemi"},{"n":56,"text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ","said":"Qala taAllahi in kidta laturdeeni"},{"n":57,"text":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ","said":"Walawla niAAmatu rabbee lakuntu mina almuhdareena"},{"n":58,"text":"أَفَمَا نَحۡنُ بِمَيِّتِينَ","said":"Afama nahnu bimayyiteena"},{"n":59,"text":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ","said":"Illa mawtatana aloola wama nahnu bimuAAaththabeena"},{"n":60,"text":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ","said":"Inna hatha lahuwa alfawzu alAAatheemu"},{"n":61,"text":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ","said":"Limithli hatha falyaAAmali alAAamiloona"},{"n":62,"text":"أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ","said":"Athalika khayrun nuzulan am shajaratu alzzaqqoomi"},{"n":63,"text":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّـٰلِمِينَ","said":"Inna jaAAalnaha fitnatan lilththalimeena"},{"n":64,"text":"إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ","said":"Innaha shajaratun takhruju fee asli aljaheemi"},{"n":65,"text":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","said":"TalAAuha kaannahu ruoosu alshshayateeni"},{"n":66,"text":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ","said":"Fainnahum laakiloona minha famalioona minha albutoona"},{"n":67,"text":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ","said":"Thumma inna lahum AAalayha lashawban min hameemin"},{"n":68,"text":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ","said":"Thumma inna marjiAAahum laila aljaheemi"},{"n":69,"text":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ","said":"Innahum alfaw abaahum dalleena"},{"n":70,"text":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ","said":"Fahum AAala atharihim yuhraAAoona"},{"n":71,"text":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ","said":"Walaqad dalla qablahum aktharu alawwaleena"},{"n":72,"text":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ","said":"Walaqad arsalna feehim munthireena"},{"n":73,"text":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ","said":"Faonthur kayfa kana AAaqibatu almunthareena"},{"n":74,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","said":"Illa AAibada Allahi almukhlaseena"},{"n":75,"text":"وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ","said":"Walaqad nadana noohun falaniAAma almujeeboona"},{"n":76,"text":"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","said":"Wanajjaynahu waahlahu mina alkarbi alAAatheemi"},{"n":77,"text":"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ","said":"WajaAAalna thurriyyatahu humu albaqeena"},{"n":78,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ","said":"Watarakna AAalayhi fee alakhireena"},{"n":79,"text":"سَلَٰمٌ عَلَىٰ نُوحٖ فِي ٱلۡعَٰلَمِينَ","said":"Salamun AAala noohin fee alAAalameena"},{"n":80,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","said":"Inna kathalika najzee almuhsineena"},{"n":81,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","said":"Innahu min AAibadina almumineena"},{"n":82,"text":"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ","said":"Thumma aghraqna alakhareena"},{"n":83,"text":"۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ","said":"Wainna min sheeAAatihi laibraheema"},{"n":84,"text":"إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبٖ سَلِيمٍ","said":"Ith jaa rabbahu biqalbin saleemin"},{"n":85,"text":"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ","said":"Ith qala liabeehi waqawmihi matha taAAbudoona"},{"n":86,"text":"أَئِفۡكًا ءَالِهَةٗ دُونَ ٱللَّهِ تُرِيدُونَ","said":"Aifkan alihatan doona Allahi tureedoona"},{"n":87,"text":"فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ","said":"Fama thannukum birabbi alAAalameena"},{"n":88,"text":"فَنَظَرَ نَظۡرَةٗ فِي ٱلنُّجُومِ","said":"Fanathara nathratan fee alnnujoomi"},{"n":89,"text":"فَقَالَ إِنِّي سَقِيمٞ","said":"Faqala innee saqeemun"},{"n":90,"text":"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ","said":"Fatawallaw AAanhu mudbireena"},{"n":91,"text":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ","said":"Faragha ila alihatihim faqala ala takuloona"},{"n":92,"text":"مَا لَكُمۡ لَا تَنطِقُونَ","said":"Ma lakum la tantiqoona"},{"n":93,"text":"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ","said":"Faragha AAalayhim darban bialyameeni"},{"n":94,"text":"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ","said":"Faaqbaloo ilayhi yaziffoona"},{"n":95,"text":"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ","said":"Qala ataAAbudoona ma tanhitoona"},{"n":96,"text":"وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ","said":"WaAllahu khalaqakum wama taAAmaloona"},{"n":97,"text":"قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ","said":"Qaloo ibnoo lahu bunyanan faalqoohu fee aljaheemi"},{"n":98,"text":"فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ","said":"Faaradoo bihi kaydan fajaAAalnahumu alasfaleena"},{"n":99,"text":"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ","said":"Waqala innee thahibun ila rabbee sayahdeeni"},{"n":100,"text":"رَبِّ هَبۡ لِي مِنَ ٱلصَّـٰلِحِينَ","said":"Rabbi hab lee mina alssaliheena"},{"n":101,"text":"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ","said":"Fabashsharnahu bighulamin haleemin"},{"n":102,"text":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَـٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ","said":"Falamma balagha maAAahu alssaAAya qala ya bunayya innee ara fee almanami annee athbahuka faonthur matha tara qala ya abati ifAAal ma tumaru satajidunee in shaa Allahu mina alssabireena"},{"n":103,"text":"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ","said":"Falamma aslama watallahu liljabeeni"},{"n":104,"text":"وَنَٰدَيۡنَٰهُ أَن يَـٰٓإِبۡرَٰهِيمُ","said":"Wanadaynahu an ya ibraheemu"},{"n":105,"text":"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","said":"Qad saddaqta alrruya inna kathalika najzee almuhsineena"},{"n":106,"text":"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَـٰٓؤُاْ ٱلۡمُبِينُ","said":"Inna hatha lahuwa albalao almubeenu"},{"n":107,"text":"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمٖ","said":"Wafadaynahu bithibhin AAatheemin"},{"n":108,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ","said":"Watarakna AAalayhi fee alakhireena"},{"n":109,"text":"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ","said":"Salamun AAala ibraheema"},{"n":110,"text":"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","said":"Kathalika najzee almuhsineena"},{"n":111,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","said":"Innahu min AAibadina almumineena"},{"n":112,"text":"وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّـٰلِحِينَ","said":"Wabashsharnahu biishaqa nabiyyan mina alssaliheena"},{"n":113,"text":"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ","said":"Wabarakna AAalayhi waAAala ishaqa wamin thurriyyatihima muhsinun wathalimun linafsihi mubeenun"},{"n":114,"text":"وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ","said":"Walaqad mananna AAala moosa waharoona"},{"n":115,"text":"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","said":"Wanajjaynahuma waqawmahuma mina alkarbi alAAatheemi"},{"n":116,"text":"وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ","said":"Wanasarnahum fakanoo humu alghalibeena"},{"n":117,"text":"وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ","said":"Waataynahuma alkitaba almustabeena"},{"n":118,"text":"وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","said":"Wahadaynahuma alssirata almustaqeema"},{"n":119,"text":"وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ","said":"Watarakna AAalayhima fee alakhireena"},{"n":120,"text":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ","said":"Salamun AAala moosa waharoona"},{"n":121,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","said":"Inna kathalika najzee almuhsineena"},{"n":122,"text":"إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","said":"Innahuma min AAibadina almumineena"},{"n":123,"text":"وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ","said":"Wainna ilyasa lamina almursaleena"},{"n":124,"text":"إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ","said":"Ith qala liqawmihi ala tattaqoona"},{"n":125,"text":"أَتَدۡعُونَ بَعۡلٗا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ","said":"AtadAAoona baAAlan watatharoona ahsana alkhaliqeena"},{"n":126,"text":"ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ","said":"Allaha rabbakum warabba abaikumu alawwaleena"},{"n":127,"text":"فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ","said":"Fakaththaboohu fainnahum lamuhdaroona"},{"n":128,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","said":"Illa AAibada Allahi almukhlaseena"},{"n":129,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ","said":"Watarakna AAalayhi fee alakhireena"},{"n":130,"text":"سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ","said":"Salamun AAala il yaseena"},{"n":131,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","said":"Inna kathalika najzee almuhsineena"},{"n":132,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","said":"Innahu min AAibadina almumineena"},{"n":133,"text":"وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ","said":"Wainna lootan lamina almursaleena"},{"n":134,"text":"إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ","said":"Ith najjaynahu waahlahu ajmaAAeena"},{"n":135,"text":"إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ","said":"Illa AAajoozan fee alghabireena"},{"n":136,"text":"ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ","said":"Thumma dammarna alakhareena"},{"n":137,"text":"وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ","said":"Wainnakum latamurroona AAalayhim musbiheena"},{"n":138,"text":"وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ","said":"Wabiallayli afala taAAqiloona"},{"n":139,"text":"وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ","said":"Wainna yoonusa lamina almursaleena"},{"n":140,"text":"إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ","said":"Ith abaqa ila alfulki almashhooni"},{"n":141,"text":"فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ","said":"Fasahama fakana mina almudhadeena"},{"n":142,"text":"فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ","said":"Failtaqamahu alhootu wahuwa muleemun"},{"n":143,"text":"فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ","said":"Falawla annahu kana mina almusabbiheena"},{"n":144,"text":"لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ","said":"Lalabitha fee batnihi ila yawmi yubAAathoona"},{"n":145,"text":"۞فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ","said":"Fanabathnahu bialAAarai wahuwa saqeemun"},{"n":146,"text":"وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةٗ مِّن يَقۡطِينٖ","said":"Waanbatna AAalayhi shajaratan min yaqteenin"},{"n":147,"text":"وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ","said":"Waarsalnahu ila miati alfin aw yazeedoona"},{"n":148,"text":"فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ","said":"Faamanoo famattaAAnahum ila heenin"},{"n":149,"text":"فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ","said":"Faistaftihim alirabbika albanatu walahumu albanoona"},{"n":150,"text":"أَمۡ خَلَقۡنَا ٱلۡمَلَـٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ","said":"Am khalaqna almalaikata inathan wahum shahidoona"},{"n":151,"text":"أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ","said":"Ala innahum min ifkihim layaqooloona"},{"n":152,"text":"وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ","said":"Walada Allahu wainnahum lakathiboona"},{"n":153,"text":"أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ","said":"Astafa albanati AAala albaneena"},{"n":154,"text":"مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ","said":"Ma lakum kayfa tahkumoona"},{"n":155,"text":"أَفَلَا تَذَكَّرُونَ","said":"Afala tathakkaroona"},{"n":156,"text":"أَمۡ لَكُمۡ سُلۡطَٰنٞ مُّبِينٞ","said":"Am lakum sultanun mubeenun"},{"n":157,"text":"فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ","said":"Fatoo bikitabikum in kuntum sadiqeena"},{"n":158,"text":"وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبٗاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ","said":"WajaAAaloo baynahu wabayna aljinnati nasaban walaqad AAalimati aljinnatu innahum lamuhdaroona"},{"n":159,"text":"سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ","said":"Subhana Allahi AAamma yasifoona"},{"n":160,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","said":"Illa AAibada Allahi almukhlaseena"},{"n":161,"text":"فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ","said":"Fainnakum wama taAAbudoona"},{"n":162,"text":"مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ","said":"Ma antum AAalayhi bifatineena"},{"n":163,"text":"إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ","said":"Illa man huwa sali aljaheemi"},{"n":164,"text":"وَمَامِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعۡلُومٞ","said":"Wama minna illa lahu maqamun maAAloomun"},{"n":165,"text":"وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ","said":"Wainna lanahnu alssaffoona"},{"n":166,"text":"وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ","said":"Wainna lanahnu almusabbihoona"},{"n":167,"text":"وَإِن كَانُواْ لَيَقُولُونَ","said":"Wain kanoo layaqooloona"},{"n":168,"text":"لَوۡ أَنَّ عِندَنَا ذِكۡرٗا مِّنَ ٱلۡأَوَّلِينَ","said":"Law anna AAindana thikran mina alawwaleena"},{"n":169,"text":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","said":"Lakunna AAibada Allahi almukhlaseena"},{"n":170,"text":"فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ","said":"Fakafaroo bihi fasawfa yaAAlamoona"},{"n":171,"text":"وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ","said":"Walaqad sabaqat kalimatuna liAAibadina almursaleena"},{"n":172,"text":"إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ","said":"Innahum lahumu almansooroona"},{"n":173,"text":"وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ","said":"Wainna jundana lahumu alghaliboona"},{"n":174,"text":"فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ","said":"Fatawalla AAanhum hatta heenin"},{"n":175,"text":"وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ","said":"Waabsirhum fasawfa yubsiroona"},{"n":176,"text":"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ","said":"AfabiAAathabina yastaAAjiloona"},{"n":177,"text":"فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ","said":"Faitha nazala bisahatihim fasaa sabahu almunthareena"},{"n":178,"text":"وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ","said":"Watawalla AAanhum hatta heenin"},{"n":179,"text":"وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ","said":"Waabsir fasawfa yubsiroona"},{"n":180,"text":"سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ","said":"Subhana rabbika rabbi alAAizzati AAamma yasifoona"},{"n":181,"text":"وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ","said":"Wasalamun AAala almursaleena"},{"n":182,"text":"وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","said":"Waalhamdu lillahi rabbi alAAalameena"}]
