[{"n":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","said":"Waylun likulli humazatin lumazatin"},{"n":2,"text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","said":"Allathee jamaAAa malan waAAaddadahu"},{"n":3,"text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","said":"Yahsabu anna malahu akhladahu"},{"n":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","said":"Kalla layunbathanna fee alhutamati"},{"n":5,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","said":"Wama adraka ma alhutamatu"},{"n":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","said":"Naru Allahi almooqadatu"},{"n":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","said":"Allatee tattaliAAu AAala alafidati"},{"n":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","said":"lnnaha AAalayhim musadatun"},{"n":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۭ","said":"Fee AAamadin mumaddadatin"}]
