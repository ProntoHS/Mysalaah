[{"n":1,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ","said":"Itha alssamao infatarat"},{"n":2,"text":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ","said":"Waitha alkawakibu intatharat"},{"n":3,"text":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ","said":"Waitha albiharu fujjirat"},{"n":4,"text":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ","said":"Waitha alqubooru buAAthirat"},{"n":5,"text":"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","said":"AAalimat nafsun ma qaddamat waakhkharat"},{"n":6,"text":"يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ","said":"Ya ayyuha alinsanu ma gharraka birabbika alkareemi"},{"n":7,"text":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","said":"Allathee khalaqaka fasawwaka faAAadalaka"},{"n":8,"text":"فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ","said":"Fee ayyi sooratin ma shaa rakkabaka"},{"n":9,"text":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ","said":"Kalla bal tukaththiboona bialddeeni"},{"n":10,"text":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","said":"Wainna AAalaykum lahafitheena"},{"n":11,"text":"كِرَامٗا كَٰتِبِينَ","said":"Kiraman katibeena"},{"n":12,"text":"يَعۡلَمُونَ مَا تَفۡعَلُونَ","said":"YaAAlamoona ma tafAAaloona"},{"n":13,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ","said":"Inna alabrara lafee naAAeemin"},{"n":14,"text":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ","said":"Wainna alfujjara lafee jaheemin"},{"n":15,"text":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ","said":"Yaslawnaha yawma alddeeni"},{"n":16,"text":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ","said":"Wama hum AAanha bighaibeena"},{"n":17,"text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","said":"Wama adraka ma yawmu alddeeni"},{"n":18,"text":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","said":"Thumma ma adraka ma yawmu alddeeni"},{"n":19,"text":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ","said":"Yawma la tamliku nafsun linafsin shayan waalamru yawmaithin lillahi"}]
