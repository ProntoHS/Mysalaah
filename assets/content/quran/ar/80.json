[{"n":1,"text":"عَبَسَ وَتَوَلَّىٰٓ","said":"AAabasa watawalla"},{"n":2,"text":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","said":"An jaahu alaAAma"},{"n":3,"text":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","said":"Wama yudreeka laAAallahu yazzakka"},{"n":4,"text":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","said":"Aw yaththakkaru fatanfaAAahu alththikra"},{"n":5,"text":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","said":"Amma mani istaghna"},{"n":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","said":"Faanta lahu tasadda"},{"n":7,"text":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","said":"Wama AAalayka alla yazzakka"},{"n":8,"text":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","said":"Waamma man jaaka yasAAa"},{"n":9,"text":"وَهُوَ يَخۡشَىٰ","said":"Wahuwa yakhsha"},{"n":10,"text":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","said":"Faanta AAanhu talahha"},{"n":11,"text":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ","said":"Kalla innaha tathkiratun"},{"n":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","said":"Faman shaa thakarahu"},{"n":13,"text":"فِي صُحُفٖ مُّكَرَّمَةٖ","said":"Fee suhufin mukarramatin"},{"n":14,"text":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","said":"MarfooAAatin mutahharatin"},{"n":15,"text":"بِأَيۡدِي سَفَرَةٖ","said":"Biaydee safaratin"},{"n":16,"text":"كِرَامِۭ بَرَرَةٖ","said":"Kiramin bararatin"},{"n":17,"text":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ","said":"Qutila alinsanu ma akfarahu"},{"n":18,"text":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","said":"Min ayyi shayin khalaqahu"},{"n":19,"text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","said":"Min nutfatin khalaqahu faqaddarahu"},{"n":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","said":"Thumma alssabeela yassarahu"},{"n":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","said":"Thumma amatahu faaqbarahu"},{"n":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","said":"Thumma itha shaa ansharahu"},{"n":23,"text":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ","said":"Kalla lamma yaqdi ma amarahu"},{"n":24,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","said":"Falyanthuri alinsanu ila taAAamihi"},{"n":25,"text":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا","said":"Anna sababna almaa sabban"},{"n":26,"text":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا","said":"Thumma shaqaqna alarda shaqqan"},{"n":27,"text":"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","said":"Faanbatna feeha habban"},{"n":28,"text":"وَعِنَبٗا وَقَضۡبٗا","said":"WaAAinaban waqadban"},{"n":29,"text":"وَزَيۡتُونٗا وَنَخۡلٗا","said":"Wazaytoonan wanakhlan"},{"n":30,"text":"وَحَدَآئِقَ غُلۡبٗا","said":"Wahadaiqa ghulban"},{"n":31,"text":"وَفَٰكِهَةٗ وَأَبّٗا","said":"Wafakihatan waabban"},{"n":32,"text":"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","said":"MataAAan lakum walianAAamikum"},{"n":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","said":"Faitha jaati alssakhkhatu"},{"n":34,"text":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ","said":"Yawma yafirru almaro min akheehi"},{"n":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","said":"Waommihi waabeehi"},{"n":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","said":"Wasahibatihi wabaneehi"},{"n":37,"text":"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ","said":"Likulli imriin minhum yawmaithin shanun yughneehi"},{"n":38,"text":"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","said":"Wujoohun yawmaithin musfiratun"},{"n":39,"text":"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","said":"Dahikatun mustabshiratun"},{"n":40,"text":"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","said":"Wawujoohun yawmaithin AAalayha ghabaratun"},{"n":41,"text":"تَرۡهَقُهَا قَتَرَةٌ","said":"Tarhaquha qataratun"},{"n":42,"text":"أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","said":"Olaika humu alkafaratu alfajaratu"}]
