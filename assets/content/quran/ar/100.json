[{"n":1,"text":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا","said":"WaalAAadiyati dabhan"},{"n":2,"text":"فَٱلۡمُورِيَٰتِ قَدۡحٗا","said":"Faalmooriyati qadhan"},{"n":3,"text":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا","said":"Faalmugheerati subhan"},{"n":4,"text":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا","said":"Faatharna bihi naqAAan"},{"n":5,"text":"فَوَسَطۡنَ بِهِۦ جَمۡعًا","said":"Fawasatna bihi jamAAan"},{"n":6,"text":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","said":"Inna alinsana lirabbihi lakanoodun"},{"n":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ","said":"Wainnahu AAala thalika lashaheedun"},{"n":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","said":"Wainnahu lihubbi alkhayri lashadeedun"},{"n":9,"text":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","said":"Afala yaAAlamu itha buAAthira ma fee alquboori"},{"n":10,"text":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","said":"Wahussila ma fee alssudoori"},{"n":11,"text":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ","said":"Inna rabbahum bihim yawmaithin lakhabeerun"}]
