[{"n":1,"text":"قُلۡ يَـٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","said":"Qul ya ayyuha alkafiroona"},{"n":2,"text":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","said":"La aAAbudu ma taAAbudoona"},{"n":3,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","said":"Wala antum AAabidoona ma aAAbudu"},{"n":4,"text":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","said":"Wala ana AAabidun ma AAabadtum"},{"n":5,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","said":"Wala antum AAabidoona ma aAAbudu"},{"n":6,"text":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","said":"Lakum deenukum waliya deeni"}]
