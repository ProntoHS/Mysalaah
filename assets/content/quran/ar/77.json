[{"n":1,"text":"وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا","said":"Waalmursalati AAurfan"},{"n":2,"text":"فَٱلۡعَٰصِفَٰتِ عَصۡفٗا","said":"FaalAAasifati AAasfan"},{"n":3,"text":"وَٱلنَّـٰشِرَٰتِ نَشۡرٗا","said":"Waalnnashirati nashran"},{"n":4,"text":"فَٱلۡفَٰرِقَٰتِ فَرۡقٗا","said":"Faalfariqati farqan"},{"n":5,"text":"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا","said":"Faalmulqiyati thikran"},{"n":6,"text":"عُذۡرًا أَوۡ نُذۡرًا","said":"AAuthran aw nuthran"},{"n":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ","said":"Innama tooAAadoona lawaqiAAun"},{"n":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ","said":"Faitha alnnujoomu tumisat"},{"n":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ","said":"Waitha alssamao furijat"},{"n":10,"text":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ","said":"Waitha aljibalu nusifat"},{"n":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ","said":"Waitha alrrusulu oqqitat"},{"n":12,"text":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ","said":"Liayyi yawmin ojjilat"},{"n":13,"text":"لِيَوۡمِ ٱلۡفَصۡلِ","said":"Liyawmi alfasli"},{"n":14,"text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ","said":"Wama adraka ma yawmu alfasli"},{"n":15,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":16,"text":"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ","said":"Alam nuhliki alawwaleena"},{"n":17,"text":"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ","said":"Thumma nutbiAAuhumu alakhireena"},{"n":18,"text":"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ","said":"Kathalika nafAAalu bialmujrimeena"},{"n":19,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":20,"text":"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ","said":"Alam nakhluqkum min main maheenin"},{"n":21,"text":"فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ","said":"FajaAAalnahu fee qararin makeenin"},{"n":22,"text":"إِلَىٰ قَدَرٖ مَّعۡلُومٖ","said":"Ila qadarin maAAloomin"},{"n":23,"text":"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ","said":"Faqadarna faniAAma alqadiroona"},{"n":24,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":25,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا","said":"Alam najAAali alarda kifatan"},{"n":26,"text":"أَحۡيَآءٗ وَأَمۡوَٰتٗا","said":"Ahyaan waamwatan"},{"n":27,"text":"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا","said":"WajaAAalna feeha rawasiya shamikhatin waasqaynakum maan furatan"},{"n":28,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":29,"text":"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","said":"Intaliqoo ila ma kuntum bihi tukaththiboona"},{"n":30,"text":"ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ","said":"Intaliqoo ila thillin thee thalathi shuAAabin"},{"n":31,"text":"لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ","said":"La thaleelin wala yughnee mina allahabi"},{"n":32,"text":"إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ","said":"Innaha tarmee bishararin kaalqasri"},{"n":33,"text":"كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ","said":"Kaannahu jimalatun sufrun"},{"n":34,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":35,"text":"هَٰذَا يَوۡمُ لَا يَنطِقُونَ","said":"Hatha yawmu la yantiqoona"},{"n":36,"text":"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ","said":"Wala yuthanu lahum fayaAAtathiroona"},{"n":37,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":38,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ","said":"Hatha yawmu alfasli jamaAAnakum waalawwaleena"},{"n":39,"text":"فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ","said":"Fain kana lakum kaydun fakeedooni"},{"n":40,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":41,"text":"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ","said":"Inna almuttaqeena fee thilalin waAAuyoonin"},{"n":42,"text":"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ","said":"Wafawakiha mimma yashtahoona"},{"n":43,"text":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ","said":"Kuloo waishraboo haneean bima kuntum taAAmaloona"},{"n":44,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","said":"Inna kathalika najzee almuhsineena"},{"n":45,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":46,"text":"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ","said":"Kuloo watamattaAAoo qaleelan innakum mujrimoona"},{"n":47,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ","said":"Waitha qeela lahumu irkaAAoo la yarkaAAoona"},{"n":49,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","said":"Waylun yawmaithin lilmukaththibeena"},{"n":50,"text":"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ","said":"Fabiayyi hadeethin baAAdahu yuminoona"}]
