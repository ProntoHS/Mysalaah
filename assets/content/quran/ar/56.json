[{"n":1,"text":"إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ","said":"Itha waqaAAati alwaqiAAatu"},{"n":2,"text":"لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ","said":"Laysa liwaqAAatiha kathibatun"},{"n":3,"text":"خَافِضَةٞ رَّافِعَةٌ","said":"Khafidatun rafiAAatun"},{"n":4,"text":"إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا","said":"Itha rujjati alardu rajjan"},{"n":5,"text":"وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا","said":"Wabussati aljibalu bassan"},{"n":6,"text":"فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا","said":"Fakanat habaan munbaththan"},{"n":7,"text":"وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ","said":"Wakuntum azwajan thalathatan"},{"n":8,"text":"فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","said":"Faashabu almaymanati ma ashabu almaymanati"},{"n":9,"text":"وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","said":"Waashabu almashamati ma ashabu almashamati"},{"n":10,"text":"وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ","said":"Waalssabiqoona alssabiqoona"},{"n":11,"text":"أُوْلَـٰٓئِكَ ٱلۡمُقَرَّبُونَ","said":"Olaika almuqarraboona"},{"n":12,"text":"فِي جَنَّـٰتِ ٱلنَّعِيمِ","said":"Fee jannati alnnaAAeemi"},{"n":13,"text":"ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ","said":"Thullatun mina alawwaleena"},{"n":14,"text":"وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ","said":"Waqaleelun mina alakhireena"},{"n":15,"text":"عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ","said":"AAala sururin mawdoonatin"},{"n":16,"text":"مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ","said":"Muttakieena AAalayha mutaqabileena"},{"n":17,"text":"يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ","said":"Yatoofu AAalayhim wildanun mukhalladoona"},{"n":18,"text":"بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ","said":"Biakwabin waabareeqa wakasin min maAAeenin"},{"n":19,"text":"لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ","said":"La yusaddaAAoona AAanha wala yunzifoona"},{"n":20,"text":"وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ","said":"Wafakihatin mimma yatakhayyaroona"},{"n":21,"text":"وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ","said":"Walahmi tayrin mimma yashtahoona"},{"n":22,"text":"وَحُورٌ عِينٞ","said":"Wahoorun AAeenun"},{"n":23,"text":"كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ","said":"Kaamthali allului almaknooni"},{"n":24,"text":"جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ","said":"Jazaan bima kanoo yaAAmaloona"},{"n":25,"text":"لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا","said":"La yasmaAAoona feeha laghwan wala tatheeman"},{"n":26,"text":"إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا","said":"Illa qeelan salaman salaman"},{"n":27,"text":"وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ","said":"Waashabu alyameeni ma ashabu alyameeni"},{"n":28,"text":"فِي سِدۡرٖ مَّخۡضُودٖ","said":"Fee sidrin makhdoodin"},{"n":29,"text":"وَطَلۡحٖ مَّنضُودٖ","said":"Watalhin mandoodin"},{"n":30,"text":"وَظِلّٖ مَّمۡدُودٖ","said":"Wathillin mamdoodin"},{"n":31,"text":"وَمَآءٖ مَّسۡكُوبٖ","said":"Wamain maskoobin"},{"n":32,"text":"وَفَٰكِهَةٖ كَثِيرَةٖ","said":"Wafakihatin katheeratin"},{"n":33,"text":"لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ","said":"La maqtooAAatin wala mamnooAAatin"},{"n":34,"text":"وَفُرُشٖ مَّرۡفُوعَةٍ","said":"Wafurushin marfooAAatin"},{"n":35,"text":"إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ","said":"Inna anshanahunna inshaan"},{"n":36,"text":"فَجَعَلۡنَٰهُنَّ أَبۡكَارًا","said":"FajaAAalnahunna abkaran"},{"n":37,"text":"عُرُبًا أَتۡرَابٗا","said":"AAuruban atraban"},{"n":38,"text":"لِّأَصۡحَٰبِ ٱلۡيَمِينِ","said":"Liashabi alyameeni"},{"n":39,"text":"ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ","said":"Thullatun mina alawwaleena"},{"n":40,"text":"وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ","said":"Wathullatun mina alakhireena"},{"n":41,"text":"وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ","said":"Waashabu alshshimali ma ashabu alshshimali"},{"n":42,"text":"فِي سَمُومٖ وَحَمِيمٖ","said":"Fee samoomin wahameemin"},{"n":43,"text":"وَظِلّٖ مِّن يَحۡمُومٖ","said":"Wathillin min yahmoomin"},{"n":44,"text":"لَّا بَارِدٖ وَلَا كَرِيمٍ","said":"La baridin wala kareemin"},{"n":45,"text":"إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ","said":"Innahum kanoo qabla thalika mutrafeena"},{"n":46,"text":"وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ","said":"Wakanoo yusirroona AAala alhinthi alAAatheemi"},{"n":47,"text":"وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ","said":"Wakanoo yaqooloona aitha mitna wakunna turaban waAAithaman ainna lamabAAoothoona"},{"n":48,"text":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ","said":"Awa abaona alawwaloona"},{"n":49,"text":"قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ","said":"Qul inna alawwaleena waalakhireena"},{"n":50,"text":"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ","said":"LamajmooAAoona ila meeqati yawmin maAAloomin"},{"n":51,"text":"ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ","said":"Thumma innakum ayyuha alddalloona almukaththiboona"},{"n":52,"text":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ","said":"Laakiloona min shajarin min zaqqoomin"},{"n":53,"text":"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ","said":"Famalioona minha albutoona"},{"n":54,"text":"فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ","said":"Fashariboona AAalayhi mina alhameemi"},{"n":55,"text":"فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ","said":"Fashariboona shurba alheemi"},{"n":56,"text":"هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ","said":"Hatha nuzuluhum yawma alddeeni"},{"n":57,"text":"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ","said":"Nahnu khalaqnakum falawla tusaddiqoona"},{"n":58,"text":"أَفَرَءَيۡتُم مَّا تُمۡنُونَ","said":"Afaraaytum ma tumnoona"},{"n":59,"text":"ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ","said":"Aantum takhluqoonahu am nahnu alkhaliqoona"},{"n":60,"text":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","said":"Nahnu qaddarna baynakumu almawta wama nahnu bimasbooqeena"},{"n":61,"text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ","said":"AAala an nubaddila amthalakum wanunshiakum fee ma la taAAlamoona"},{"n":62,"text":"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ","said":"Walaqad AAalimtumu alnnashata aloola falawla tathakkaroona"},{"n":63,"text":"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ","said":"Afaraaytum ma tahruthoona"},{"n":64,"text":"ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّـٰرِعُونَ","said":"Aantum tazraAAoonahu am nahnu alzzariAAoona"},{"n":65,"text":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ","said":"Law nashao lajaAAalnahu hutaman fathaltum tafakkahoona"},{"n":66,"text":"إِنَّا لَمُغۡرَمُونَ","said":"Inna lamughramoona"},{"n":67,"text":"بَلۡ نَحۡنُ مَحۡرُومُونَ","said":"Bal nahnu mahroomoona"},{"n":68,"text":"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ","said":"Afaraaytumu almaa allathee tashraboona"},{"n":69,"text":"ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ","said":"Aantum anzaltumoohu mina almuzni am nahnu almunziloona"},{"n":70,"text":"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ","said":"Law nashao jaAAalnahu ojajan falawla tashkuroona"},{"n":71,"text":"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ","said":"Afaraaytumu alnnara allatee tooroona"},{"n":72,"text":"ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ","said":"Aantum anshatum shajarataha am nahnu almunshioona"},{"n":73,"text":"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ","said":"Nahnu jaAAalnaha tathkiratan wamataAAan lilmuqweena"},{"n":74,"text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","said":"Fasabbih biismi rabbika alAAatheemi"},{"n":75,"text":"۞فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","said":"Fala oqsimu bimawaqiAAi alnnujoomi"},{"n":76,"text":"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ","said":"Wainnahu laqasamun law taAAlamoona AAatheemun"},{"n":77,"text":"إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ","said":"Innahu laquranun kareemun"},{"n":78,"text":"فِي كِتَٰبٖ مَّكۡنُونٖ","said":"Fee kitabin maknoonin"},{"n":79,"text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ","said":"La yamassuhu illa almutahharoona"},{"n":80,"text":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ","said":"Tanzeelun min rabbi alAAalameena"},{"n":81,"text":"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ","said":"Afabihatha alhadeethi antum mudhinoona"},{"n":82,"text":"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ","said":"WatajAAaloona rizqakum annakum tukaththiboona"},{"n":83,"text":"فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ","said":"Falawla itha balaghati alhulqooma"},{"n":84,"text":"وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ","said":"Waantum heenaithin tanthuroona"},{"n":85,"text":"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ","said":"Wanahnu aqrabu ilayhi minkum walakin la tubsiroona"},{"n":86,"text":"فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ","said":"Falawla in kuntum ghayra madeeneena"},{"n":87,"text":"تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ","said":"TarjiAAoonaha in kuntum sadiqeena"},{"n":88,"text":"فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ","said":"Faamma in kana mina almuqarrabeena"},{"n":89,"text":"فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ","said":"Farawhun warayhanun wajannatu naAAeemin"},{"n":90,"text":"وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ","said":"Waamma in kana min ashabi alyameeni"},{"n":91,"text":"فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ","said":"Fasalamun laka min ashabi alyameeni"},{"n":92,"text":"وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ","said":"Waamma in kana mina almukaththibeena alddalleena"},{"n":93,"text":"فَنُزُلٞ مِّنۡ حَمِيمٖ","said":"Fanuzulun min hameemin"},{"n":94,"text":"وَتَصۡلِيَةُ جَحِيمٍ","said":"Watasliyatu jaheemin"},{"n":95,"text":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ","said":"Inna hatha lahuwa haqqu alyaqeeni"},{"n":96,"text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","said":"Fasabbih biismi rabbika alAAatheemi"}]
