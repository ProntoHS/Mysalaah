[{"n":1,"text":"وَٱلضُّحَىٰ","said":"Waaldduha"},{"n":2,"text":"وَٱلَّيۡلِ إِذَا سَجَىٰ","said":"Waallayli itha saja"},{"n":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","said":"Ma waddaAAaka rabbuka wama qala"},{"n":4,"text":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ","said":"Walalakhiratu khayrun laka mina aloola"},{"n":5,"text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","said":"Walasawfa yuAAteeka rabbuka fatarda"},{"n":6,"text":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ","said":"Alam yajidka yateeman faawa"},{"n":7,"text":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ","said":"Wawajadaka dallan fahada"},{"n":8,"text":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ","said":"Wawajadaka AAailan faaghna"},{"n":9,"text":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","said":"Faamma alyateema fala taqhar"},{"n":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","said":"Waamma alssaila fala tanhar"},{"n":11,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","said":"Waamma biniAAmati rabbika fahaddith"}]
