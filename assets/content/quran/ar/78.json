[{"n":1,"text":"عَمَّ يَتَسَآءَلُونَ","said":"AAamma yatasaaloona"},{"n":2,"text":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ","said":"AAani alnnabai alAAatheemi"},{"n":3,"text":"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ","said":"Allathee hum feehi mukhtalifoona"},{"n":4,"text":"كَلَّا سَيَعۡلَمُونَ","said":"Kalla sayaAAlamoona"},{"n":5,"text":"ثُمَّ كَلَّا سَيَعۡلَمُونَ","said":"Thumma kalla sayaAAlamoona"},{"n":6,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا","said":"Alam najAAali alarda mihadan"},{"n":7,"text":"وَٱلۡجِبَالَ أَوۡتَادٗا","said":"Waaljibala awtadan"},{"n":8,"text":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا","said":"Wakhalaqnakum azwajan"},{"n":9,"text":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا","said":"WajaAAalna nawmakum subatan"},{"n":10,"text":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا","said":"WajaAAalna allayla libasan"},{"n":11,"text":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا","said":"WajaAAalna alnnahara maAAashan"},{"n":12,"text":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا","said":"Wabanayna fawqakum sabAAan shidadan"},{"n":13,"text":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا","said":"WajaAAalna sirajan wahhajan"},{"n":14,"text":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا","said":"Waanzalna mina almuAAsirati maan thajjajan"},{"n":15,"text":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا","said":"Linukhrija bihi habban wanabatan"},{"n":16,"text":"وَجَنَّـٰتٍ أَلۡفَافًا","said":"Wajannatin alfafan"},{"n":17,"text":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا","said":"Inna yawma alfasli kana meeqatan"},{"n":18,"text":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا","said":"Yawma yunfakhu fee alssoori fatatoona afwajan"},{"n":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا","said":"Wafutihati alssamao fakanat abwaban"},{"n":20,"text":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا","said":"Wasuyyirati aljibalu fakanat saraban"},{"n":21,"text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا","said":"Inna jahannama kanat mirsadan"},{"n":22,"text":"لِّلطَّـٰغِينَ مَـَٔابٗا","said":"Lilttagheena maaban"},{"n":23,"text":"لَّـٰبِثِينَ فِيهَآ أَحۡقَابٗا","said":"Labitheena feeha ahqaban"},{"n":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا","said":"La yathooqoona feeha bardan wala sharaban"},{"n":25,"text":"إِلَّا حَمِيمٗا وَغَسَّاقٗا","said":"Illa hameeman waghassaqan"},{"n":26,"text":"جَزَآءٗ وِفَاقًا","said":"Jazaan wifaqan"},{"n":27,"text":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا","said":"Innahum kanoo la yarjoona hisaban"},{"n":28,"text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا","said":"Wakaththaboo biayatina kiththaban"},{"n":29,"text":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا","said":"Wakulla shayin ahsaynahu kitaban"},{"n":30,"text":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا","said":"Fathooqoo falan nazeedakum illa AAathaban"},{"n":31,"text":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا","said":"Inna lilmuttaqeena mafazan"},{"n":32,"text":"حَدَآئِقَ وَأَعۡنَٰبٗا","said":"Hadaiqa waaAAnaban"},{"n":33,"text":"وَكَوَاعِبَ أَتۡرَابٗا","said":"WakawaAAiba atraban"},{"n":34,"text":"وَكَأۡسٗا دِهَاقٗا","said":"Wakasan dihaqan"},{"n":35,"text":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّـٰبٗا","said":"La yasmaAAoona feeha laghwan wala kiththaban"},{"n":36,"text":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا","said":"Jazaan min rabbika AAataan hisaban"},{"n":37,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا","said":"Rabbi alssamawati waalardi wama baynahuma alrrahmani la yamlikoona minhu khitaban"},{"n":38,"text":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا","said":"Yawma yaqoomu alrroohu waalmalaikatu saffan la yatakallamoona illa man athina lahu alrrahmanu waqala sawaban"},{"n":39,"text":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","said":"Thalika alyawmu alhaqqu faman shaa ittakhatha ila rabbihi maaban"},{"n":40,"text":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","said":"Inna antharnakum AAathaban qareeban yawma yanthuru almaro ma qaddamat yadahu wayaqoolu alkafiru ya laytanee kuntu turaban"}]
