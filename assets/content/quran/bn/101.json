[{"n": 1, "text": "ভীতিপ্ৰদ মহা বিপদ  [১]"}, {"n": 2, "text": "ভীতিপ্ৰদ মহা বিপদ কী?"}, {"n": 3, "text": "আর ভীতিপ্ৰদ মহা বিপদ সম্পর্কে আপনাকে কিসে জানাবে?"}, {"n": 4, "text": "সেদিন মানুষ হবে বিক্ষিপ্ত পতঙ্গের মত [১]"}, {"n": 5, "text": "আর পর্বতসমূহ হবে ধুনিত রঙ্গিন পশমের মত [১]।"}, {"n": 6, "text": "অতঃপর যার পাল্লাসমূহ [১] ভারী হবে [২],"}, {"n": 7, "text": "সে তো থাকবে সন্তোষজনক জীবনে।"}, {"n": 8, "text": "আর যার পাল্লাসমূহ হাল্কা হবে [১]"}, {"n": 9, "text": "তার স্থান হবে ‘হাওয়িয়াহ্’ [১]।"}, {"n": 10, "text": "আর আপনাকে কিসে জানাবে সেটা কী?"}, {"n": 11, "text": "অত্যন্ত উত্তপ্ত আগুন [১]।"}]