[{"n":1,"text":"当太阳黯黜的时候，"},{"n":2,"text":"当星宿零落的时候，"},{"n":3,"text":"当山峦崩溃的时候，"},{"n":4,"text":"当孕驼被抛弃的时候，"},{"n":5,"text":"当野兽被集合的时候，"},{"n":6,"text":"当海洋澎湃的时候，"},{"n":7,"text":"当灵魂被配合的时候，"},{"n":8,"text":"当被活埋的女孩被询问的时候："},{"n":9,"text":"她为什么罪过而遭杀害呢？"},{"n":10,"text":"当功过薄被展开的时候，"},{"n":11,"text":"当天皮被揭去的时候，"},{"n":12,"text":"当火狱被燃着的时候，"},{"n":13,"text":"当乐园被送近的时候，"},{"n":14,"text":"每个人都知道他所作过的善恶。"},{"n":15,"text":"我誓以运行的众星"},{"n":16,"text":"没落的行星，"},{"n":17,"text":"和逝去时的黑夜，"},{"n":18,"text":"照耀时的早晨，"},{"n":19,"text":"这确是一个尊贵的使者的言辞，"},{"n":20,"text":"他在宝座的主那里，是有权力的，是有地位的，"},{"n":21,"text":"是众望所归，而且忠於职守的。"},{"n":22,"text":"你们的朋友，不是一个疯人，"},{"n":23,"text":"他确已看见那个天使在明显的天边，"},{"n":24,"text":"他对幽玄不是吝教的。"},{"n":25,"text":"这不是被放逐的恶魔的言辞，"},{"n":26,"text":"你们将往哪里去呢？"},{"n":27,"text":"这只是对于众世界的教诲——"},{"n":28,"text":"对於你们中欲循规蹈矩者的教诲，"},{"n":29,"text":"你们不欲循规蹈矩，除非安拉——众世界的主——意欲的时候。"}]
