[{"n":1,"text":"大难，"},{"n":2,"text":"大难是什么，"},{"n":3,"text":"你怎能知道大难是什么？"},{"n":4,"text":"在那日, 众人将似分散的飞蛾，"},{"n":5,"text":"山岳将似疏松的采绒。"},{"n":6,"text":"至于善功的分量较重者，"},{"n":7,"text":"将在满意的生活中；"},{"n":8,"text":"至于善功的分量较轻者，"},{"n":9,"text":"他的归宿是深坑。"},{"n":10,"text":"你怎能知道深坑里有什么？"},{"n":11,"text":"有烈火。"}]
