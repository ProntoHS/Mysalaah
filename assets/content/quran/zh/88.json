[{"n":1,"text":"大灾的消息，确已降临你了，"},{"n":2,"text":"在那日，将有许多人是恭敬的、"},{"n":3,"text":"劳动的、辛苦的，"},{"n":4,"text":"他们将入烈火，"},{"n":5,"text":"将饮沸泉，"},{"n":6,"text":"他们没有食物，但有荆棘，"},{"n":7,"text":"既不肥人，又不能充饥；"},{"n":8,"text":"在那日，将有许多人，是享福的，"},{"n":9,"text":"是为其劳绩而愉快的，"},{"n":10,"text":"他们将在崇高的乐园中，"},{"n":11,"text":"听不到恶言，"},{"n":12,"text":"里面有流泉，"},{"n":13,"text":"里面有高榻，"},{"n":14,"text":"有陈设着的杯盏，"},{"n":15,"text":"有排列着的靠枕，"},{"n":16,"text":"有铺展开的绒毯。"},{"n":17,"text":"难道他们不观察吗？骆驼是怎样造成的，"},{"n":18,"text":"天是怎样被升高的，"},{"n":19,"text":"山峦是怎样被竖立起的，"},{"n":20,"text":"大地是怎样被展开的。"},{"n":21,"text":"你当教诲，你只是教诲（他们的），"},{"n":22,"text":"你绝不是监察他们的，"},{"n":23,"text":"但谁转身离去而且不信教，"},{"n":24,"text":"安拉将以最大的刑罚惩治谁。"},{"n":25,"text":"他们必定只归于我，"},{"n":26,"text":"他们的稽核，必定由我负责。"}]
