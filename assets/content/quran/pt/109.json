[{"n": 1, "text": "Dize: \"Ó renegadores da Fé!\""}, {"n": 2, "text": "\"Não adoro o[1] que adorais.\""}, {"n": 3, "text": "\"Nem adorareis o que adoro.\""}, {"n": 4, "text": "\"Nem adorarei o que adorastes.\""}, {"n": 5, "text": "\"Nem adorareis o que adoro.\""}, {"n": 6, "text": "\"A vós vossa religião[1] e, a mim, minha religião.\"[2]"}]